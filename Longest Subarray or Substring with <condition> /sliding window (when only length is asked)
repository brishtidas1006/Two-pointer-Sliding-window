#include <bits/stdc++.h>
using namespace std;
#define ll long long
#define endl "\n"
int main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);
    cout.tie(0);
    ll n, k; cin >> n >> k;
    vector<ll> arr(n);

    for(ll i = 0; i < n; i++) cin >> arr[i];

    ll l = 0, r = 0, maxlen = 0;
    ll sum = 0;

    while(r < n){
        sum += arr[r];
        if(sum > k){
            sum -= arr[l];
            l += 1;
        }
        else if(sum <= k){
            maxlen = max(maxlen, r - l+1);
        }
        r += 1
        ;

    }
    cout << maxlen << endl;


}
