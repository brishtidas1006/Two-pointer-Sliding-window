// Time complexity O(n+n)
// Space complexity O(1)

// IF question is asking SUBARRAY, we must follow shrink, expand approch 

#include <bits/stdc++.h>
using namespace std;
#define ll long long

int main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);
    cout.tie(0);

    ll n, k; cin >> n >> k;
    // k = sum here;
    vector<ll> arr(n);
    for(ll i = 0; i < n ; i++) cin >> arr[i];

    ll l = 0, r = 0, maxlen = 0;
    ll sum = 0;
    ll pos = 0;
    while(r < n){
        sum += arr[r];
        while(sum > k){
            sum -= arr[l];
            l += 1;
        }
        if(sum <= k){
            maxlen = max(maxlen, r-l+1);
            pos = r;
        }

        r += 1;
    }

    cout << maxlen << endl;
    for(ll i = pos - maxlen; i < pos; i++){
        cout << arr[i] << " ";
    }



}
