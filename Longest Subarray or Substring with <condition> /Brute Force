#include <bits/stdc++.h>
using namespace std;
#define ll long long

int main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);
    cout.tie(0);

    ll n, k; cin >> n >> k;
    // k = sum here;
    vector<ll> arr(n);
    for(ll i = 0; i < n ; i++) cin >> arr[i];

    ll maxlen = 0;

    for(ll i = 0; i < n; i++){
            ll sum = 0;
        for(ll j = i; j < n; j++){
            sum += arr[j];
            if(sum <= k){
                maxlen = max(maxlen, j - i + 1);
            }
        }
        cout << endl;
    }

    cout << maxlen << endl;




}
