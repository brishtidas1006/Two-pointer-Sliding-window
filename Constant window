#include <bits/stdc++.h>
using namespace std;
#define ll long long

int main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0);
    cout.tie(0);

    ll n, k; cin >> n >> k;
    vector<ll> arr(n);
    for(ll i = 0; i < n; i++) cin >> arr[i];

    ll sum = 0;

    for(ll i = 0; i < k; i++){
        sum += arr[i];
    }
    ll l = 0, r = k -1;
    ll maxsum = 0;
    while(r < n-1){
        sum -= arr[l];
        l++;
        r++;
        sum += arr[r];

        maxsum = max(maxsum, sum);
    }
    cout << maxsum << endl;




}
